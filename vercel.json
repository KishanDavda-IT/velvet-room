{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/r/:roomId/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/r/:roomId",
      "destination": "/index.html"
    }
  ]
}
